{
  "name": "boggle",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "netlify:dev": "netlify dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "difficulty": "bunx tsx src/lib/scripts/boardDifficulty.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "netlify dev:exec drizzle-kit migrate",
    "db:studio": "netlify dev:exec drizzle-kit studio"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.5",
    "drizzle-kit": "^0.31.10",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "@types/seedrandom": "^3.0.8",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "@netlify/functions": "^5.3.0",
    "@netlify/neon": "^0.1.2",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "crypto": "^1.0.1",
    "drizzle-orm": "^0.45.2",
    "js-confetti": "^0.13.1",
    "netlify-cli": "^27.0.1",
    "openapi-fetch": "^0.17.0",
    "seedrandom": "^3.0.5"
  },
  "overrides": { "esbuild": "^0.28.0" },
  "trustedDependencies": ["esbuild", "@esbuild/darwin-arm64"]
